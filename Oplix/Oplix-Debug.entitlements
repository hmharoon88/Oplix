<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    Debug / dev profiles → sandbox APNs. Release uses Oplix-Release.entitlements
	    with `production` so TestFlight / App Store builds receive pushes when
	    the phone is locked. A single entitlements file with `development` breaks
	    production delivery (tokens + gateway mismatch).
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
