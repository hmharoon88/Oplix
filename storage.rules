rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }

    function userExists(uid) {
      return userDoc(uid) != null;
    }

    // Same tenant logic as Firestore — manager owns path, staff uses managerUserId.
    function canAccessManagerFiles(managerUserId) {
      return isSignedIn() && (
        request.auth.uid == managerUserId
        || (
          userExists(request.auth.uid)
          && userDoc(request.auth.uid).data.role in ['employee', 'supervisor']
          && userDoc(request.auth.uid).data.get('managerUserId', '') == managerUserId
        )
      );
    }

    match /task_images/{managerUserId}/{locationId}/{taskId}/{fileName=**} {
      allow read, write: if canAccessManagerFiles(managerUserId);
    }

    match /lottery_form_images/{managerUserId}/{locationId}/{formId}/{fileName=**} {
      allow read, write: if canAccessManagerFiles(managerUserId);
    }

    match /documents/{managerUserId}/{locationId}/{fileName=**} {
      allow read, write: if canAccessManagerFiles(managerUserId);
    }

    match /compliance_attachments/{managerUserId}/{locationId}/{itemId}/{fileName=**} {
      allow read, write: if canAccessManagerFiles(managerUserId);
    }

    match /invoice_files/{managerUserId}/{fileName=**} {
      allow read, write: if canAccessManagerFiles(managerUserId);
    }

    // Deny anything else by default (no catch-all).
  }
}
